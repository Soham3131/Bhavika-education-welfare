# ==============================================================================
# Environment Configuration Template — Bhavika Foundation & Jai Maa Durga Store
# ==============================================================================
# Copy this file to .env.local for local development.
# For production (Vercel), configure these variables in Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & URLs
# ------------------------------------------------------------------------------
NODE_ENV=development
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="bhavika_dev"
JMD_MONGODB_DB_NAME="jai_maa_durga"

# ------------------------------------------------------------------------------
# 3. Authentication & Security (NextAuth / Auth.js)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-character-random-secret-here"
AUTH_URL="http://localhost:3000"

# Secret required in addition to email/password for admin panel access
ADMIN_ACCESS_CODE="BHAVIKA-ADMIN-2026"

# Initial admin seeding credentials
SEED_ADMIN_EMAIL="admin@bhavikafoundation.org"
SEED_ADMIN_PASSWORD="StrongPassword123!"

# ------------------------------------------------------------------------------
# 4. Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_FOLDER="bhavika"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# ------------------------------------------------------------------------------
# 5. Transactional Email (Brevo / Sendinblue API v3)
# ------------------------------------------------------------------------------
BREVO_API_KEY="xkeysib-your-brevo-api-key"
EMAIL_FROM_NAME="Bhavika Foundation"
EMAIL_FROM="alerts@avanienterprises.in"

# ------------------------------------------------------------------------------
# 6. Scheduled Worker & Cron Security (Vercel Cron)
# ------------------------------------------------------------------------------
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# Protects /api/cron/expire-coupons and /api/cron/reconcile-refunds
CRON_SECRET="your-secure-cron-secret-here"

# ------------------------------------------------------------------------------
# 7. Payment Gateway (Razorpay — Donations & Store Checkout/Refunds)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"

# ------------------------------------------------------------------------------
# 8. Phase 2 — Jai Maa Durga Store & Bhavika Integration
# ------------------------------------------------------------------------------
BHAVIKA_API_BASE="http://localhost:3000"
BHAVIKA_INTEGRATION_SECRET="staging-store-secret-2026"
JMD_INTEGRATION_SECRET="staging-bhavika-secret-2026"
JMD_REDEMPTION_ENABLED="true"
ALLOW_MOCK_RECHARGE="true"
